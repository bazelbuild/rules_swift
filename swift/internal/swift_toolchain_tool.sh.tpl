#!/usr/bin/env bash

# Generated by the `swift_toolchain_tool` rule. Runs a tool from the resolved
# Swift toolchain, forwarding all arguments.

# --- begin runfiles.bash initialization v3 ---
# Copy-pasted from the Bazel Bash runfiles library v3.
set -uo pipefail; set +e; f=bazel_tools/tools/bash/runfiles/runfiles.bash
# shellcheck disable=SC1090
source "${RUNFILES_DIR:-/dev/null}/$f" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "${RUNFILES_MANIFEST_FILE:-/dev/null}" | cut -f2- -d' ')" 2>/dev/null || \
  source "$0.runfiles/$f" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "$0.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "$0.exe.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null || \
  { echo>&2 "ERROR: cannot find $f"; exit 1; }; f=; set -e
# --- end runfiles.bash initialization v3 ---

set -o errexit -o nounset -o pipefail

# The tool to run, e.g. `swift` or `swift-format`.
readonly tool=%tool%

# Runfiles path of the toolchain's `swift` driver when it is a `File`; empty
# otherwise.
readonly swift_rlocationpath=%swift_rlocationpath%

# The toolchain's `swift` driver when it is a string (a bare name or a path);
# empty otherwise.
readonly swift_string=%swift_string%

# Arguments that must precede the user's arguments when running `swift` itself
# (e.g. `--driver-mode=swift` for a custom driver).
swift_args=(%swift_args%)

# Runfiles path of Bazel's `xcode-locator`, used on macOS to find the Xcode
# that Bazel selected.
readonly xcode_locator_rlocationpath=%xcode_locator_rlocationpath%

# Environment required by the toolchain.
%env_exports%

fail() {
  echo >&2 "ERROR: swift_toolchain_tool: ${*}"
  exit 1
}

# Prints the canonical path of a file, following every symlink. `realpath` is
# missing from macOS before 13, so fall back to a `readlink` loop there.
resolve_path() {
  local path="${1}"
  if command -v realpath >/dev/null 2>&1; then
    realpath "${path}"
    return
  fi
  local dir link
  local hops=0
  while [[ -L "${path}" ]]; do
    hops=$((hops + 1))
    if [[ ${hops} -gt 40 ]]; then
      echo >&2 "too many levels of symbolic links resolving '${1}'"
      return 1
    fi
    dir="$(cd -P "$(dirname "${path}")" && pwd)" || return 1
    link="$(readlink "${path}")" || return 1
    if [[ "${link}" == /* ]]; then
      path="${link}"
    else
      path="${dir}/${link}"
    fi
  done
  dir="$(cd -P "$(dirname "${path}")" && pwd)" || return 1
  echo "${dir}/$(basename "${path}")"
}

# Apple toolchains launch every tool through `xcrun`, matching the worker that
# runs the toolchain's compile actions.
use_xcrun=false
if [[ "$(uname -s)" == "Darwin" ]]; then
  use_xcrun=true

  # Bazel sets `DEVELOPER_DIR` for actions but not for `bazel run`, and `xcrun`
  # ignores `XCODE_VERSION_OVERRIDE`. Map the Xcode version that Bazel selected
  # to its developer directory so that `xcrun` uses that Xcode instead of the
  # `xcode-select` one. Never override a `DEVELOPER_DIR` that Bazel or a remote
  # executor already set.
  if [[ -z "${DEVELOPER_DIR:-}" && -n "${XCODE_VERSION_OVERRIDE:-}" ]]; then
    xcode_locator="$(rlocation "${xcode_locator_rlocationpath}")" || true
    if [[ -z "${xcode_locator}" || ! -x "${xcode_locator}" ]]; then
      fail "cannot locate '${xcode_locator_rlocationpath}' in runfiles"
    fi
    # `xcode-locator` logs every Xcode it finds to stderr; show that only if
    # it fails.
    locator_stderr="$(mktemp)"
    if ! developer_dir="$(
      "${xcode_locator}" "${XCODE_VERSION_OVERRIDE}" 2>"${locator_stderr}"
    )" || [[ -z "${developer_dir}" ]]; then
      cat >&2 "${locator_stderr}"
      rm -f "${locator_stderr}"
      fail "cannot find Xcode ${XCODE_VERSION_OVERRIDE}, which Bazel" \
        "selected (e.g. with --xcode_version); is it installed?"
    fi
    rm -f "${locator_stderr}"
    export DEVELOPER_DIR="${developer_dir}"
  fi
fi

run() {
  if [[ "${use_xcrun}" == "true" ]]; then
    exec /usr/bin/xcrun "${@}"
  fi
  exec "${@}"
}

if [[ -n "${swift_rlocationpath}" ]]; then
  swift="$(rlocation "${swift_rlocationpath}")" || true
  if [[ -z "${swift}" || ! -e "${swift}" ]]; then
    fail "cannot locate the Swift driver '${swift_rlocationpath}' in runfiles"
  fi
  if [[ "${tool}" == "swift" ]]; then
    # Run the runfiles entry, not its resolved target: the driver picks its
    # mode from the name it was invoked by.
    run "${swift}" ${swift_args[@]+"${swift_args[@]}"} "${@}"
  fi
  # Other tools are siblings of the driver. Standalone toolchains list them in
  # the runfiles next to it; otherwise fall back to the directory of the
  # driver's real path.
  tool_path="$(dirname "${swift}")/${tool}"
  if [[ ! -x "${tool_path}" ]]; then
    real_swift="$(resolve_path "${swift}")" ||
      fail "cannot resolve the real path of '${swift}'"
    tool_path="$(dirname "${real_swift}")/${tool}"
  fi
  if [[ ! -x "${tool_path}" ]]; then
    fail "cannot find '${tool}' next to the Swift driver at '${tool_path}'"
  fi
  run "${tool_path}" "${@}"
fi

if [[ -z "${swift_string}" ]]; then
  fail "the Swift toolchain does not provide a 'swift' driver"
fi

if [[ "${swift_string}" == */* ]]; then
  # A path into a toolchain; the other tools are its siblings.
  tool_path="$(dirname "${swift_string}")/${tool}"
  if [[ ! -x "${tool_path}" ]]; then
    fail "cannot find '${tool}' at '${tool_path}'"
  fi
else
  tool_path="${tool}"
fi

if [[ "${use_xcrun}" != "true" && "${tool_path}" != */* ]] &&
  ! command -v "${tool_path}" >/dev/null 2>&1; then
  fail "cannot find '${tool_path}' on PATH"
fi

if [[ "${tool}" == "swift" ]]; then
  run "${tool_path}" ${swift_args[@]+"${swift_args[@]}"} "${@}"
fi
run "${tool_path}" "${@}"
